{
    "name": "magna-cms/blog",
    "description": "A Magna CMS plugin.",
    "type": "magna-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "magna-cms/plugin-sdk": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MagnaCms\\Blog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagnaCms\\Blog\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
